# ==============================================================================
# VIONEX VIDEO PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# 1. CORE APPLICATION
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
CLIENT_ORIGIN=http://localhost:3000
JWT_SECRET=replace_with_strong_crypto_random_key_min_64_chars
COOKIE_SECRET=replace_with_strong_cookie_secret_min_32_chars

# 2. DATABASE & REDIS
DATABASE_URL=postgresql://vionex:your_password@localhost:5432/vionex_db
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# 3. STORAGE & CDN
STORAGE_DRIVER=local # 'local' or 's3'
LOCAL_STORAGE_DIR=./data/storage
STORAGE_PUBLIC_URL=http://localhost:4000/storage
S3_BUCKET=
S3_ENDPOINT=
AWS_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 4. MEDIA PROCESSING & FFMPEG
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_CONCURRENT_TRANSCODES=1
ENABLE_WHISPER_TRANSCRIPTION=false

# 5. LIVE STREAMING
ENABLE_LIVE_STREAMING=true
RTMP_PORT=1935

# 6. P2P & BANDWIDTH OPTIMIZATION
ENABLE_P2P=true
P2P_TRACKER_URL=wss://tracker.vionex.tv

# 7. MONETIZATION & PAYMENTS
ENABLE_MONETIZATION=true
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# 8. EMAIL & NOTIFICATIONS
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@vionex.tv
