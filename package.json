{
  "name": "vionex",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @vionex/api\" \"npm run dev -w @vionex/web\" \"npm run start -w @vionex/media-worker\"",
    "build": "npm run build --workspaces",
    "test": "vitest run",
    "parity:report": "ts-node scripts/parity-report.ts",
    "db:generate": "npm run prisma:generate -w @vionex/database",
    "db:migrate": "npm run prisma:migrate -w @vionex/database"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
